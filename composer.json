{
  "name": "cleber-oliveira/zait-tiny-framework",
  "description": "Framework PHP leve com roteamento declarativo, controllers e acesso a dados via PDO.",
  "type": "project",
  "keywords": [
    "php",
    "framework",
    "routing",
    "pdo"
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "phpmailer/phpmailer": "^7.0",
    "twilio/sdk": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app/"
    }
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": false
  }
}
